+        .unwrap();
+        target.activate();
+        let target_raw_queue = target.thread_backend.raw_pkts_queue.clone();
+
+        let mut source = VhostUserVsockThread::new(
+            BackendType::UnixDomainSocket(test_dir.path().join("source-vsock.sock")),
+            SOURCE_CID,
+            CONN_TX_BUF_SIZE,
+            vec![SHARED_GROUP.to_string()],
+            cid_map,
+        )
+        .unwrap();
+        source.activate();
+
+        // Model guest RAM and a split TX virtqueue. Each available entry
+        // contains a readable VSOCK header followed by a readable payload.
+        let guest_memory =
+            GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 40 * 1024 * 1024)])
+                .unwrap();
+        let mem = GuestMemoryAtomic::new(guest_memory);
+        source.mem = Some(mem.clone());
+        let mem_handle = mem.memory();
+
+        let mock_queue =
+            MockSplitQueue::create(&*mem_handle, GuestAddress(0x1000), TX_QUEUE_SIZE);
+        let mut next_addr = 0x1_0000u64;
+        let mut descriptors = Vec::with_capacity(PACKET_COUNT * 2);
+        let payload = vec![0x5a; PAYLOAD_SIZE];
+
+        let mut packet_storage = vec![0u8; PKT_HEADER_SIZE + PAYLOAD_SIZE];
+        let (header, data) = packet_storage.split_at_mut(PKT_HEADER_SIZE);
+        // SAFETY: the packet header and payload are disjoint valid buffers.
+        let mut packet = unsafe { VsockPacket::new(header, Some(data)).unwrap() };
+        packet
+            .set_type(crate::vhu_vsock::VSOCK_TYPE_STREAM)
+            .set_src_cid(SOURCE_CID)
+            .set_dst_cid(TARGET_CID)
+            .set_src_port(9000)
+            .set_dst_port(1234)
+            .set_op(crate::vhu_vsock::VSOCK_OP_RW)
+            .set_len(PAYLOAD_SIZE as u32);
+        let mut header_bytes = vec![0u8; PKT_HEADER_SIZE];
+        packet.header_slice().copy_to(&mut header_bytes);
+        drop(packet);
+
+        for packet_index in 0..PACKET_COUNT {
+            let header_addr = next_addr;
+            let data_addr = header_addr + PKT_HEADER_SIZE as u64;
+            mem_handle
+                .write(&header_bytes, GuestAddress(header_addr))
+                .unwrap();
+            mem_handle
+                .write(&payload, GuestAddress(data_addr))
+                .unwrap();
+
+            let head_index = (packet_index * 2) as u16;
+            descriptors.push(SplitDescriptor::new(
+                header_addr,
+                PKT_HEADER_SIZE as u32,
+                VRING_DESC_F_NEXT as u16,
+                head_index + 1,
+            ));
+            descriptors.push(SplitDescriptor::new(
+                data_addr,
+                PAYLOAD_SIZE as u32,
+                0,
+                0,
+            ));
+            next_addr = data_addr + PAYLOAD_SIZE as u64;
+        }
+
+        let raw_descriptors: Vec<RawDescriptor> =
+            descriptors.into_iter().map(RawDescriptor::from).collect();
+        mock_queue
+            .build_multiple_desc_chains(&raw_descriptors)
+            .expect("could not build guest TX descriptor chains");
+
+        let queue: Queue = mock_queue.create_queue().unwrap();
+        let vring = VringRwLock::new(mem.clone(), TX_QUEUE_SIZE).unwrap();
