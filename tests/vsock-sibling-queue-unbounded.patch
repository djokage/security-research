+        };
+        use vm_memory::{Bytes, GuestAddress};
+
+        const SOURCE_CID: u64 = 40;
+        const TARGET_CID: u64 = 41;
+        const PACKET_COUNT: usize = 511;
+        const PAYLOAD_SIZE: usize = CONN_TX_BUF_SIZE as usize;
